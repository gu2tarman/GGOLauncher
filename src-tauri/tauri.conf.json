{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GGOLauncher",
  "version": "0.1.3",
  "identifier": "com.gu2tarman.ggolauncher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GGO Launcher",
        "width": 1100,
        "height": 720,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
